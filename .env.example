# Finite-choice decision backend. Defaults to TypeSafe SystemOne, but may point to a compatible local gateway.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional aliases / local backend override:
# JEV_DECISION_API_KEY=
# JEV_DECISION_BASE_URL=http://127.0.0.1:9000/v1/systemone
# JEV_DECISION_MODEL=jev-local

# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Fully local run (no keys): install Ollama, `ollama pull qwen3:8b`,
# `ollama serve`, then `OLLAMA_MODEL=qwen3:8b uv run python scripts/local_backend.py` and set:
# JEV_DECISION_BASE_URL=http://127.0.0.1:9000/v1/systemone
# JEV_DECISION_MODEL=jev-local
# JEV_MODEL_TIMEOUT=240                       (local inference is slower than 25s default)
# TEXT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# TEXT_MODEL=qwen3:8b
# TEXT_MODEL_REASONING=none   (required — Ollama rejects reasoning fields)

# basic redacts incidental emails, long account/card-like numbers, API-secret
# patterns, URL userinfo, and token-shaped URL path segments.
# Set to off only when the caller intentionally wants raw page text sent to
# the model — requires JEV_MODEL_ROUTING=public (or local-only); the
# sanitized default refuses to compose with off.
JEV_MODEL_PRIVACY=basic
# Hard serialized request budget in bytes.
JEV_MODEL_BODY_LIMIT=262144

# Data-routing level for the run: local-only | sanitized (default) | public.
# local-only fails closed if any model endpoint resolves off-loopback;
# sanitized redacts the goal before it enters a request body; public sends
# the goal verbatim (declare the task non-sensitive explicitly).
# JEV_MODEL_ROUTING=sanitized
# Every non-loopback model endpoint requires https. This escape exists only
# for local development — never set it on a qualified run.
# JEV_ALLOW_INSECURE_TRANSPORT=1
# Browser input guarantee: atomic (default, isolated-world validate+mutate)
# or trusted (real CDP input for sites that ignore synthetic events).
# JEV_INPUT_GUARANTEE=atomic
