# Finite-choice decision backend. Defaults to TypeSafe SystemOne, but may point to a compatible local gateway.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional aliases / local backend override:
# JEV_DECISION_API_KEY=
# JEV_DECISION_BASE_URL=http://127.0.0.1:9000/v1/systemone
# JEV_DECISION_MODEL=jev-local

# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# basic redacts incidental emails, long account/card-like numbers, and API-secret patterns.
# Set to off only when the caller intentionally wants raw page text sent to the model.
JEV_MODEL_PRIVACY=basic
# Hard serialized request budget in bytes.
JEV_MODEL_BODY_LIMIT=262144
