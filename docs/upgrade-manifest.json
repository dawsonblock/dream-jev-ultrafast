{
  "project": "jev-ultrafast",
  "version": "0.4.1",
  "release_name": "DREAM-Jev Qualification Control Plane",
  "based_on": "jev-ultrafast v0.3.0 DREAM-Jev",
  "design_source": {
    "title": "Dream-RSI: Recursive Self-Improvement through Evolving Worlds",
    "arxiv": "2609.14858v1",
    "used_concepts": [
      "online exploration produces reusable historical traces",
      "historical discovery experience becomes an empirical replay simulator",
      "exploration policy improves offline while execution/evaluation interfaces remain fixed",
      "improved exploration policy is redeployed online"
    ],
    "intentional_deviation": "DREAM-Jev remains conservative trajectory-retention replay: it never predicts that the fixed decision model would choose a different browser action or invent an unseen DOM outcome."
  },
  "trusted_computing_base": "jev-ultrafast-tcb/0.5",
  "experience_schema": "jev-dream/2",
  "backward_read_compatibility": [
    "jev-dream/1",
    "jev-ultrafast-tcb/0.3",
    "jev-ultrafast-tcb/0.4"
  ],
  "self_improvable": [
    "candidate ranking weights",
    "candidate quotas",
    "model action budget",
    "browser action budget",
    "no-progress stopping patience"
  ],
  "non_self_modifiable": [
    "isolated-world DOM identity",
    "freshness and target guards",
    "browser mutation implementation",
    "approval and deny policy",
    "privacy/redaction rules",
    "completion verifier contract",
    "replay objective implementation",
    "evidence hash-chain verification",
    "promotion/canary/health gates",
    "policy registry, suspension, and rollback implementation"
  ],
  "v0_4_upgrades": [
    "cross-process experience-store locking",
    "corrupt-tail append refusal",
    "candidate catalogue digest and selected rank evidence",
    "world-pool and split-manifest replay provenance",
    "evidence-head binding",
    "all-split replay candidate qualification",
    "parent-digest policy lineage",
    "paired task-family canary evidence",
    "live latency/action/token regression gates",
    "unbound canary promotion disabled by default",
    "active-policy health monitoring and suspension",
    "policy history and rollback",
    "multi-command jev-dream operational CLI"
  ],
  "default_canary_gate": {
    "baseline_tasks_min": 12,
    "candidate_tasks_min": 12,
    "candidate_task_families_min": 4,
    "paired_task_families_min": 4,
    "paired_family_coverage_min": 0.8,
    "verified_success_regression": 0.0,
    "extra_risk_events": 0,
    "extra_risk_rate": 0.0,
    "failure_rate_regression": 0.0,
    "average_latency_regression_ratio_max": 0.25,
    "average_action_regression_ratio_max": 0.25,
    "average_token_regression_ratio_max": 0.25
  },
  "validation": {
    "offline_tests_passed": 113,
    "python_compileall": "passed",
    "javascript_syntax": "passed",
    "toml_json_parse": "passed",
    "dream_cli_smoke": "passed",
    "cross_process_store_test": "passed",
    "cross_process_registry_test": "passed",
    "ruff": "passed",
    "uv_build": "passed",
    "live_browser_harness": "passed: 23 guard checks against dedicated Chrome 152 via BU_CDP_URL"
  }
}
